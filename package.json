  "dependencies": {
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.12.0",
    "globals": "17.13.0"
